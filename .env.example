# Copy to .env locally. In production, set these as private host environment variables.
# Never commit .env or put secrets in frontend code.

DJANGO_SECRET_KEY=replace-with-generated-secret-at-least-50-characters
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000

# Production only: PostgreSQL URL supplied by your managed database provider.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=your-domain.example,www.your-domain.example,your-app-host.example
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example,https://www.your-domain.example
# SITE_URL=https://your-domain.example
# DJANGO_SECURE_SSL_REDIRECT=True
# Enable HSTS (e.g. 3600 seconds) only after HTTPS is verified end-to-end.
# DJANGO_HSTS_SECONDS=3600
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_HSTS_PRELOAD=False
# MEDIA_ROOT must be durable storage mounted by your host, or implement object storage.
# MEDIA_ROOT=/mounted/durable/path/media

# Payments: COD is enabled and is the checkout default. Razorpay stays disabled
# until you have completed website review and receive credentials. Configure both
# values privately to reveal Razorpay checkout; do not add keys to source control.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Django SMTP. Choose any transactional provider that gives you SMTP credentials.
# Verify your sending domain's SPF/DKIM/DMARC and sender address with that provider.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=LOOM&LEAF <orders@your-domain.example>
EMAIL_HOST=smtp.your-provider.example
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
